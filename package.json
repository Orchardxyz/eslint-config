{
  "name": "@oryz/eslint-config",
  "version": "2.1.0",
  "description": "Personal reusable ESLint flat config for Oryz projects.",
  "type": "module",
  "packageManager": "pnpm@8.15.5",
  "private": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Orchardxyz/eslint-config.git"
  },
  "homepage": "https://github.com/Orchardxyz/eslint-config#readme",
  "bugs": {
    "url": "https://github.com/Orchardxyz/eslint-config/issues"
  },
  "keywords": [
    "eslint",
    "eslintconfig",
    "flat-config",
    "typescript"
  ],
  "scripts": {
    "build": "tsup",
    "changeset": "changeset",
    "prelint": "pnpm build",
    "lint": "eslint .",
    "prepack": "pnpm build",
    "pretest": "pnpm build",
    "release": "changeset publish",
    "test": "node --test test/index.test.mjs",
    "typecheck": "tsc --noEmit",
    "check": "pnpm build && eslint . && pnpm typecheck && node --test test/index.test.mjs"
  },
  "dependencies": {
    "@eslint/js": "^10.0.1",
    "eslint-plugin-import-x": "^4.16.2",
    "eslint-plugin-svelte": "^3.20.0",
    "eslint-plugin-vue": "^10.9.2",
    "eslint-plugin-yml": "^3.5.0",
    "globals": "^17.6.0",
    "svelte-eslint-parser": "^1.8.0",
    "typescript-eslint": "^8.59.4",
    "vue-eslint-parser": "^10.4.1",
    "yaml-eslint-parser": "^2.0.0"
  },
  "peerDependencies": {
    "eslint": "^10.0.0",
    "svelte": "^3.37.0 || ^4.0.0 || ^5.0.0",
    "typescript": ">=5.0.0 <6.1.0"
  },
  "peerDependenciesMeta": {
    "svelte": {
      "optional": true
    }
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.0",
    "@types/node": "^25.9.1",
    "eslint": "^10.4.0",
    "svelte": "^5.56.5",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3"
  }
}
