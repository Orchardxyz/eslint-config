{
  "compilerOptions": {
    "allowJs": true,
    "ignoreDeprecations": "6.0",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "strict": true,
    "target": "ES2022",
    "types": ["node"]
  },
  "include": [
    "eslint.config.mjs",
    "scripts/**/*.mjs",
    "src/**/*.ts",
    "src/**/*.d.ts",
    "test/**/*.mjs"
  ]
}
